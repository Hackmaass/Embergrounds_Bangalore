# Cortex runs fully offline with no variables set — every value below is
# optional and gates a single live integration. Copy to `.env` and fill in
# only what you have; anything unset falls back to its offline-safe default.

# --- apps/server ---
PORT=3200

# Signs/verifies decision contracts (packages/runtime/src/decisions.ts).
# Falls back to a dev-only constant if unset — set a real secret for anything
# beyond local demo use. Changing this value invalidates every decision
# already staged under the old secret (they will 500 on approve/reject) —
# run POST /api/demo/reset after rotating it.
CORTEX_DECISION_SECRET=

# WhatsApp is connected via Baileys (packages/channels/src/whatsapp-baileys.ts)
# — the same approach OpenClaw uses: an unofficial WhatsApp Web protocol
# client, linked by scanning a QR code (WhatsApp -> Settings -> Linked
# Devices -> Link a Device). No Meta business app or token needed — the
# server always attempts to link at boot and prints/serves the QR
# (GET /api/channels/whatsapp/status, also shown in the Channels view).
# This is NOT Meta's sanctioned API; use a secondary/test number, not your
# primary one. Session credentials persist under WHATSAPP_AUTH_DIR so you
# only scan once — this is a relative path resolved from the server
# process's cwd (apps/server/ when launched via `pnpm --filter @cortex/server
# start`), so keep launching it the same way, or set an absolute path here
# if you might not.
WHATSAPP_AUTH_DIR=.baileys-auth

# Using the SAME number for the QR scan and DEMO_WHATSAPP_RECIPIENT below
# works — approve/reject replies in that number's own WhatsApp self-chat are
# handled explicitly — but everything (cards, vouchers, reminders,
# payslips) lands in one thread, which gets busy on stage. Cleaner for a
# demo: link a burner/secondary number for the QR scan, set
# DEMO_WHATSAPP_RECIPIENT to your own number.

# Meta Cloud API (packages/channels/src/whatsapp.ts) — the original,
# business-verified path this project was first built against. Kept as
# reference/production alternative; not instantiated anywhere by default
# (Baileys is what's wired for the demo). Only relevant if you later swap
# BaileysWhatsAppChannel for WhatsAppChannel in apps/server/src/index.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=cortex-verify

# Telegram Bot API long-polling (packages/channels/src/telegram.ts). Leave
# unset to keep the Telegram channel in SIMULATOR mode and skip starting the
# poll loop entirely.
TELEGRAM_BOT_TOKEN=

# Seeded demo customers/staff/suppliers carry fake phone numbers that can't
# receive anything real. Set these to your own WhatsApp number (with country
# code, digits only, e.g. 919876543210) / Telegram chat id to redirect every
# live send there instead — the only way to see genuine delivery in a demo.
# Leave both unset and live sends will try the seeded fake ids and fail
# safely (logged, not fatal) rather than reach a real stranger.
DEMO_WHATSAPP_RECIPIENT=
DEMO_TELEGRAM_RECIPIENT=

# LLM provider (packages/runtime/src/llm.ts). One of "anthropic" | "ollama" |
# "offline". Defaults to "anthropic" if ANTHROPIC_API_KEY is set, else
# "ollama" — no agent's money-math path depends on any of these being live;
# a downed/unset provider degrades to a deterministic offline stub.
LLM_PROVIDER=

# Anthropic API. Only used when LLM_PROVIDER=anthropic (or left unset with
# this key present).
ANTHROPIC_API_KEY=

# Local Ollama server — no key, no network egress. Used by default when
# ANTHROPIC_API_KEY is unset. Requires `ollama serve` running locally and
# the model pulled (`ollama pull qwen2.5:7b-instruct`). num_ctx is fixed at
# 4096 in code to keep resident VRAM low on small GPUs (~4.8GB on a cold
# load, verified on an 8GB-VRAM laptop GPU — if the model is already
# resident at a larger context from something else on the machine, Ollama
# reuses that instance and VRAM use will be higher until it's unloaded).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- scripts/verify-api.ts ---
CORTEX_API_BASE=http://localhost:3200

# --- apps/web ---
VITE_API_BASE=http://localhost:3200
