# Cortex runs fully offline with no variables set — every value below is
# optional and gates a single live integration. Copy to `.env` and fill in
# only what you have; anything unset falls back to its offline-safe default.

# --- apps/server ---
PORT=3200

# Signs/verifies decision contracts (packages/runtime/src/decisions.ts).
# Falls back to a dev-only constant if unset — set a real secret for anything
# beyond local demo use. Changing this value invalidates every decision
# already staged under the old secret (they will 500 on approve/reject) —
# run POST /api/demo/reset after rotating it.
CORTEX_DECISION_SECRET=

# WhatsApp Cloud API (packages/channels/src/whatsapp.ts). Leave unset to keep
# the WhatsApp channel in SIMULATOR mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=cortex-verify

# Telegram Bot API long-polling (packages/channels/src/telegram.ts). Leave
# unset to keep the Telegram channel in SIMULATOR mode and skip starting the
# poll loop entirely.
TELEGRAM_BOT_TOKEN=

# Anthropic API (packages/runtime/src/llm.ts). Leave unset to use the
# deterministic offline LLM stub — no agent behavior requires a live key.
ANTHROPIC_API_KEY=

# --- scripts/verify-api.ts ---
CORTEX_API_BASE=http://localhost:3200

# --- apps/web ---
VITE_API_BASE=http://localhost:3200
